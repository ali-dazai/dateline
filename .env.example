# Copy this file to .env and fill in your key. Never commit .env.
GEMINI_API_KEY=paste-your-key-here
# OpenRouter key, used by models named openrouter/... (https://openrouter.ai/keys).
OPENROUTER_API_KEY=paste-your-key-here
# Anthropic key for the direct-API fallback below (optional).
ANTHROPIC_API_KEY=

# Answer model: the SAME model for all three experiment setups.
# Run `python scripts/check_setup.py` to check that the model answers.
DATELINE_MODEL=openrouter/anthropic/claude-haiku-5.5
# Judge model (can be cheaper or the same).
DATELINE_JUDGE_MODEL=openrouter/anthropic/claude-haiku-5.5
# Tried once if the model above keeps failing. Defaults to anthropic/claude-haiku-5-5
# when ANTHROPIC_API_KEY is set, otherwise there is no fallback.
# DATELINE_FALLBACK_MODEL=anthropic/claude-haiku-5-5

# Seconds between LLM calls (0.5 suits a paid OpenRouter key; use 4.2 on the Gemini free tier).
DATELINE_MIN_INTERVAL=0.5

# fake = canned answers (dateline/fake_engine.py); real = the module in DATELINE_ENGINE_MODULE:
# pipeline.engine (the retrieval pipeline; build its index with `python -m pipeline.index`).
DATELINE_ENGINE=fake
DATELINE_ENGINE_MODULE=pipeline.engine
DATELINE_CORPUS=data/articles.parquet

# Guardian Open Platform key (free developer key) for the 2008 and 2023 stories.
GUARDIAN_API_KEY=paste-your-key-here
